rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Allow public read for events
    match /events/{event} {
      allow read: if true;
      allow write: if false; // Only admin via console/CLI
    }

    // Bookings — anyone can create, no one can read/edit from client
    match /bookings/{booking} {
      allow create: if request.resource.data.email != null && 
                      request.resource.data.name != null &&
                      request.resource.data.email.size() < 100;
      allow read, update, delete: if false; 
    }

    // Contact messages — anyone can create
    match /contact_messages/{msg} {
      allow create: if request.resource.data.email != null && 
                      request.resource.data.message != null &&
                      request.resource.data.message.size() < 1000;
      allow read, update, delete: if false;
    }

    // Book Purchases - specific access by ID
    match /book_purchases/{purchaseId} {
      allow get, create, update: if true;
      allow list: if false; // Deny queries/listing to protect PII
    }

    // Default deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
