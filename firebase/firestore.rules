rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Allow public read for events
    match /events/{event} {
      allow read: if true;
      allow write: if false; // Only admin via console/CLI
    }

    // Bookings — anyone can create, no one can read/edit from client
    match /bookings/{booking} {
      allow create: if true;
      allow read, update, delete: if false; // Admin only via console
    }

    // Contact messages — anyone can create
    match /contact_messages/{msg} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // Default deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
